# Environment and secrets
.env
.env.*
!.env.example

# Local planning and agent context
# These are personal planning/assistant files, not app source.
/local/
/AGENTS.md
/CLAUDE.md
/CLAUDE.local.md
/.claude/

# PHP / Laravel dependencies and local artifacts
/vendor/
/.tools/
/.phpunit.cache
/.phpunit.result.cache
/auth.json
/storage/*.key
/storage/pail
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Laravel runtime/generated files
# Storage subdirectories carry their own .gitignore files (Laravel default);
# do not add blanket /storage/* rules here, as a parent-directory ignore
# rule would also hide storage/app/private and storage/app/public.
/bootstrap/ssr
/public/build/
/public/fonts-manifest.dev.json
/public/hot
/public/storage/

# Wayfinder-generated frontend route/action helpers (regenerated on
# dev/build; not source).
/resources/js/actions/
/resources/js/routes/
/resources/js/wayfinder/

# JavaScript / frontend dependencies and builds
/node_modules/
/dist/
/coverage/
/site/node_modules/
/site/dist/
/site/.astro/
/site/.netlify/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor noise
.DS_Store
Thumbs.db
/.idea/
/.vscode/
/.fleet/
