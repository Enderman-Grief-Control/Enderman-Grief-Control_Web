# Environment and secrets
.env
.env.*
!.env.example

# Local planning and agent context
# These are personal planning/assistant files, not app source.
/local/
/AGENTS.md
/CLAUDE.md
/CLAUDE.local.md
/.claude/

# PHP / Laravel dependencies and local artifacts
/vendor/
/.phpunit.result.cache
/auth.json
/storage/*.key

# Laravel runtime/generated files
/public/build/
/public/hot
/public/storage/
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# JavaScript / frontend dependencies and builds
/node_modules/
/dist/
/build/
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor noise
.DS_Store
Thumbs.db
/.idea/
/.vscode/
/.fleet/
