---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Enderman Grief Control</title>
    <meta
      name="description"
      content="A public site scaffold for the Enderman Grief Control Minecraft mod."
    />
  </head>
  <body>
    <main class="min-h-screen bg-zinc-950 text-zinc-100">
      <section class="mx-auto flex min-h-screen max-w-5xl flex-col justify-center px-6 py-16">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-emerald-300">
          Public site scaffold
        </p>
        <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight sm:text-6xl">
          Enderman Grief Control
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-300">
          A lightweight Astro foundation for the public project site. Final
          homepage content, distribution links, and project metadata will arrive
          in later M0 slices.
        </p>
      </section>
    </main>
  </body>
</html>
