---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { dashboardHref, distributions, github, modrinth, portfolioHref } from '../data/links';

import deniedPickupLog from '../assets/screenshots/denied-pickup-summary-log.png';
import fabricConfig from '../assets/screenshots/fabric-config-screen.png';
import griefPrevented from '../assets/screenshots/grief-prevented-sunset-field.png';
import vanillaGrief from '../assets/screenshots/vanilla-grief-sunset-field.png';

const title = 'Enderman Grief Control';
const description =
  'Stop endermen from picking up and placing blocks without turning off mobGriefing. A lightweight Paper plugin and Fabric mod for Minecraft 1.21.';

const features = [
  {
    title: 'Endermen only',
    body: 'Every other mob keeps its vanilla behavior, and the mobGriefing gamerule is never modified.',
  },
  {
    title: 'No block pickup',
    body: 'Endermen can no longer lift blocks out of your builds, terrain, or farm platforms.',
  },
  {
    title: 'No block placement',
    body: 'No stray blocks dropped across your world, far from where they were taken.',
  },
  {
    title: 'Stuck holder cleanup',
    body: 'Endermen already carrying a block never despawn and keep filling your mob cap. Auto-clear their held blocks, get an alert, or leave them be.',
  },
];

const officialLinks = [...distributions, github];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title}: stop Enderman griefing on Paper and Fabric`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased">
    <header class="absolute inset-x-0 top-0 z-20">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5"
        aria-label="Primary"
      >
        <a href="/" class="text-sm font-semibold tracking-wide text-white">
          Enderman <span class="text-fuchsia-300">Grief Control</span>
        </a>
        <div class="flex items-center gap-5 text-sm font-medium text-zinc-200">
          <a href="#download" class="hover:text-white">Download</a>
          <a href={github.href} class="hover:text-white">GitHub</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="relative isolate flex min-h-[92vh] items-end overflow-hidden">
        <Image
          src={griefPrevented}
          alt="Dozens of endermen standing on an intact grass platform at sunset, every block still in place."
          widths={[960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
        />
        <div
          class="absolute inset-0 -z-10 bg-gradient-to-t from-zinc-950 via-zinc-950/60 to-zinc-950/10"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute inset-0 -z-10 bg-gradient-to-r from-zinc-950/80 via-zinc-950/30 to-transparent"
          aria-hidden="true"
        >
        </div>

        <div class="mx-auto w-full max-w-6xl px-6 pt-32 pb-16 sm:pb-24">
          <div class="flex flex-wrap gap-2 text-xs font-medium">
            <span class="rounded-full border border-white/15 bg-zinc-950/50 px-3 py-1 text-zinc-200 backdrop-blur">
              Paper plugin
            </span>
            <span class="rounded-full border border-white/15 bg-zinc-950/50 px-3 py-1 text-zinc-200 backdrop-blur">
              Fabric mod
            </span>
            <span class="rounded-full border border-white/15 bg-zinc-950/50 px-3 py-1 text-zinc-200 backdrop-blur">
              Minecraft 1.21
            </span>
          </div>
          <h1 class="mt-6 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-white sm:text-6xl">
            Enderman Grief Control
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-200 sm:text-xl">
            Stop Enderman griefing without turning off <code
              class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-[0.9em] text-fuchsia-200"
              >mobGriefing</code
            >. Endermen can't pick up or place blocks. Every other mob plays by vanilla rules.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={modrinth.href}
              class="rounded-lg bg-fuchsia-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-fuchsia-950/40 hover:bg-fuchsia-400"
            >
              Download on Modrinth
            </a>
            <a
              href={github.href}
              class="rounded-lg border border-white/20 bg-zinc-950/40 px-5 py-3 text-sm font-semibold text-white backdrop-blur hover:border-white/40 hover:bg-zinc-950/60"
            >
              View on GitHub
            </a>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-6 py-20" aria-labelledby="comparison-heading">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-amber-300">Same field, same sunset</p>
        <h2 id="comparison-heading" class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          One night of endermen, with and without the mod
        </h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <figure class="overflow-hidden rounded-xl border border-white/10 bg-zinc-900">
            <Image
              src={vanillaGrief}
              alt="The same grass platform in vanilla Minecraft, torn full of holes, with endermen carrying and dropping grass blocks."
              widths={[640, 960]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-video w-full object-cover"
            />
            <figcaption class="flex items-center justify-between gap-4 px-5 py-4 text-sm">
              <span class="font-semibold text-zinc-100">Vanilla</span>
              <span class="text-zinc-400">Torn-up terrain</span>
            </figcaption>
          </figure>
          <figure class="overflow-hidden rounded-xl border border-fuchsia-400/30 bg-zinc-900">
            <Image
              src={griefPrevented}
              alt="The grass platform with Enderman Grief Control enabled, completely intact under the same crowd of endermen."
              widths={[640, 960]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-video w-full object-cover"
            />
            <figcaption class="flex items-center justify-between gap-4 px-5 py-4 text-sm">
              <span class="font-semibold text-fuchsia-200">With Enderman Grief Control</span>
              <span class="text-zinc-400">Untouched</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="border-y border-white/5 bg-zinc-900/60" aria-labelledby="features-heading">
        <div class="mx-auto max-w-6xl px-6 py-20">
          <p class="text-sm font-medium uppercase tracking-[0.2em] text-amber-300">What it does</p>
          <h2 id="features-heading" class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
            The one mob you can't design around, handled at the source
          </h2>
          <p class="mt-5 max-w-3xl leading-7 text-zinc-300">
            Endermen teleport straight through spawn-proofing, and once one grabs a block it
            lingers, eating into your mob cap and slowing every farm nearby. Enderman Grief Control
            stops the behavior itself instead of switching off griefing for the whole world.
          </p>
          <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              features.map((feature) => (
                <li class="rounded-xl border border-white/10 bg-zinc-950/60 p-6">
                  <span class="block h-1.5 w-8 rounded-full bg-fuchsia-400" aria-hidden="true"></span>
                  <h3 class="mt-4 font-semibold text-white">{feature.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-zinc-400">{feature.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-6 py-20" aria-labelledby="proof-heading">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-amber-300">See it working</p>
        <h2 id="proof-heading" class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Quiet by default, visible when you want it
        </h2>
        <div class="mt-10 grid items-center gap-10 lg:grid-cols-[3fr_2fr]">
          <Image
            src={deniedPickupLog}
            alt="In-game chat listing aggregated [Enderman] Denied pickup counts in the hundreds while endermen stand around blocks left in place."
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 60vw, 100vw"
            class="w-full rounded-xl border border-white/10"
          />
          <div>
            <h3 class="text-xl font-semibold text-white">Optional denied-attempt logging</h3>
            <p class="mt-3 leading-7 text-zinc-300">
              Turn on logging to watch blocked pickups roll up into short summaries instead of
              flooding chat. Stuck holders cleared by the mod are reported the same way, so you can
              see the cleanup happen.
            </p>
          </div>
        </div>
        <div class="mt-16 grid items-center gap-10 lg:grid-cols-[2fr_3fr]">
          <div class="lg:order-first">
            <h3 class="text-xl font-semibold text-white">Simple configuration on both platforms</h3>
            <p class="mt-3 leading-7 text-zinc-300">
              Paper servers get a per-world <code class="font-mono text-sm text-fuchsia-200">config.yml</code>.
              Fabric players get an in-game settings screen through Mod Menu. Both reload live with
              <code class="font-mono text-sm text-fuchsia-200">/enderman reload</code>, no restart needed.
            </p>
          </div>
          <Image
            src={fabricConfig}
            alt="Fabric in-game config screen with toggles for Prevent Enderman Grief, Stuck Holders: Auto-Clear, Log Removals, and Log Denied Attempts."
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 60vw, 100vw"
            class="w-full rounded-xl border border-white/10"
          />
        </div>
      </section>

      <section id="download" class="border-t border-white/5 bg-zinc-900/60" aria-labelledby="download-heading">
        <div class="mx-auto max-w-6xl px-6 py-20">
          <p class="text-sm font-medium uppercase tracking-[0.2em] text-amber-300">Download</p>
          <h2 id="download-heading" class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
            Get it from an official source
          </h2>
          <p class="mt-5 max-w-2xl leading-7 text-zinc-300">
            Running a server? Grab the Paper plugin. Playing singleplayer or hosting a Fabric
            server? Grab the Fabric mod.
          </p>
          <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              officialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="group flex h-full flex-col rounded-xl border border-white/10 bg-zinc-950/60 p-6 hover:border-fuchsia-400/50"
                  >
                    <span class="text-xs font-medium uppercase tracking-[0.15em] text-zinc-500">
                      {link.platform}
                    </span>
                    <span class="mt-2 text-lg font-semibold text-white">{link.name}</span>
                    <span class="mt-2 text-sm leading-6 text-zinc-400">{link.description}</span>
                    <span class="mt-auto pt-5 text-sm font-medium text-fuchsia-300 group-hover:text-fuchsia-200">
                      Open {link.name} &rarr;
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/5">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
        <p>Enderman Grief Control. Open source under Apache 2.0.</p>
        <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
          {
            officialLinks.map((link) => (
              <a href={link.href} class="hover:text-zinc-300">
                {link.name === 'CurseForge' ? `CurseForge (${link.platform})` : link.name}
              </a>
            ))
          }
          <a href={portfolioHref} class="text-zinc-600 hover:text-zinc-400">Built by Jack Underhill</a>
          <a href={dashboardHref} class="text-zinc-600 hover:text-zinc-400">Maintainer dashboard</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
